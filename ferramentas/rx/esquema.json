{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "raiox/rx-carta",
 "title": "Carta RX — formato próprio do Raio-X (T12, 24/11/2026)",
 "description": "Uma carta como o motor e os pesos enxergam: nada de inglês. Gerado pelo conversor (T13) a partir do Forge (comportamento) + Scryfall (dados). Vocabulário escolhido pela cobertura (planejamento/cobertura.md): 95% das cópias do banco de 30. O que não couber vai em 'falta'.",
 "type": "object",
 "required": [
  "n",
  "tipos"
 ],
 "additionalProperties": false,
 "properties": {
  "n": {
   "type": "string",
   "description": "nome oficial (frente, para dupla face)"
  },
  "custo": {
   "$ref": "#/$defs/mana"
  },
  "vm": {
   "type": "integer",
   "description": "valor de mana"
  },
  "ci": {
   "type": "string",
   "pattern": "^W?U?B?R?G?$",
   "description": "identidade de cor (CR 903.4)"
  },
  "cores": {
   "type": "string",
   "pattern": "^W?U?B?R?G?$"
  },
  "tipos": {
   "type": "array",
   "items": {
    "enum": [
     "Creature",
     "Artifact",
     "Enchantment",
     "Land",
     "Planeswalker",
     "Instant",
     "Sorcery",
     "Battle",
     "Kindred"
    ]
   }
  },
  "super": {
   "type": "array",
   "items": {
    "enum": [
     "Legendary",
     "Basic",
     "Snow",
     "World"
    ]
   }
  },
  "sub": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "subtipos (Goblin, Equipment, Aura, Forest, Saga, Adventure…)"
  },
  "pt": {
   "type": "array",
   "items": {
    "type": [
     "integer",
     "string"
    ]
   },
   "minItems": 2,
   "maxItems": 2,
   "description": "[poder, resistência]; '*' quando definido por estática cda"
  },
  "leal": {
   "type": "integer",
   "description": "lealdade inicial"
  },
  "kw": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/kw"
   }
  },
  "atv": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/atv"
   }
  },
  "gat": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/gat"
   }
  },
  "est": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/est"
   }
  },
  "subst": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/subst"
   }
  },
  "fx": {
   "$ref": "#/$defs/fxs",
   "description": "efeito ao resolver (mágica instantânea/feitiço)"
  },
  "alvos": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/alvo"
   },
   "description": "alvos escolhidos ao conjurar, referidos em fx por {\"alvo\":i}"
  },
  "faces": {
   "type": "array",
   "items": {
    "$ref": "#"
   },
   "description": "outra face: dupla face, aventura, split, modal"
  },
  "forma": {
   "enum": [
    "normal",
    "duplaFace",
    "aventura",
    "split",
    "modal",
    "flip"
   ]
  },
  "falta": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "pedaços que o conversor não entendeu (item do Forge); o motor joga o resto e a tela avisa"
  },
  "forge": {
   "type": "string",
   "description": "arquivo de origem no Forge (rastreio, GPL-3)"
  },
  "custoAd": {
   "$ref": "#/$defs/custoAtv",
   "description": "custo adicional para conjurar (além da mana)"
  }
 },
 "$defs": {
  "mana": {
   "type": "object",
   "additionalProperties": false,
   "description": "custo de mana: g = genérico, p = símbolos coloridos (W U B R G C, híbrido 'R/W', 2/W, phyrexiano 'B/P'), x = quantos X",
   "properties": {
    "g": {
     "type": "integer"
    },
    "p": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^([WUBRGCS]|[WUBRGC2]/[WUBRGP]|[WUBRG]/[WUBRG]/P)$"
     }
    },
    "x": {
     "type": "integer"
    }
   }
  },
  "qtd": {
   "description": "número fixo, 'X' (o X pago), ou contagem",
   "oneOf": [
    {
     "type": "integer"
    },
    {
     "enum": [
      "X",
      "maoInteira",
      "tudo"
     ]
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "conta"
     ],
     "properties": {
      "conta": {
       "oneOf": [
        {
         "$ref": "#/$defs/filtro"
        },
        {
         "enum": [
          "vmDoAlvo",
          "vmDoEvento",
          "poderDoEste",
          "poderDoEvento",
          "resistDoEvento",
          "poderDoAlvo",
          "danoCausado",
          "vidaGanha",
          "cartasNaMao",
          "oponentes",
          "marcadoresNoEste",
          "evento",
          "X",
          "jogadores",
          "resistDoEste",
          "vmDoEste",
          "lembrados",
          "suaVida",
          "vidaInicial",
          "cartasNoGrimorio",
          "energia",
          "convergir",
          "dominio",
          "devocao",
          "impostoCmd",
          "seusTurnos",
          "resolvidasNoTurno",
          "magiasNoTurno",
          "coresDoEste",
          "resistDoAlvo",
          "marcadoresNoEvento",
          "maoDoAlvo",
          "vidaDoAlvo",
          "tipoMaisComum",
          "maiorEntreJogadores",
          "entrouNoTurno",
          "resultado",
          "se",
          "numeroEscolhido",
          "vidaGanhaNoTurno",
          "compradasNoTurno",
          "atacantes",
          "coresDoEvento",
          "ataquesNoTurno",
          "grimorioDoAlvo",
          "marcadoresSeus",
          "vezesKicker",
          "maoDoEvento",
          "vidaPerdidaOpsNoTurno",
          "vidaPerdidaNoTurno"
         ]
        }
       ]
      },
      "mult": {
       "type": "integer"
      },
      "soma": {
       "type": "integer"
      },
      "alvo": {
       "type": "integer"
      },
      "metade": {
       "type": "boolean",
       "description": "divide por 2 (arredonda p/ baixo)"
      },
      "cond": {
       "type": "string",
       "description": "conta 'se': condição (kicked, promisedgift, morbid…)"
      },
      "sim": {
       "type": "integer"
      },
      "nao": {
       "type": "integer"
      },
      "prop": {
       "enum": [
        "cores",
        "somaPoder",
        "maiorPoder",
        "somaResist",
        "somaVm",
        "nomesDiferentes",
        "tiposDiferentes"
       ],
       "description": "em vez de contar objetos: propriedade do conjunto"
      },
      "de": {
       "type": "string",
       "description": "devocao: cores (W U B R G); marcadores*: tipo do marcador"
      }
     }
    }
   ]
  },
  "jogador": {
   "enum": [
    "voce",
    "oponente",
    "cadaOponente",
    "cadaJogador",
    "alvoJogador",
    "dono",
    "controlador",
    "doEvento",
    "atacado",
    "proximo",
    "cadaAtual"
   ],
   "description": "quem (sem alvo): voce = controlador da carta; doEvento = o jogador do evento do gatilho; controlador/dono = do objeto afetado"
  },
  "filtro": {
   "type": "object",
   "additionalProperties": false,
   "description": "mini-linguagem de objetos: todos os campos se somam (E)",
   "properties": {
    "este": {
     "type": "boolean",
     "description": "a própria carta"
    },
    "outro": {
     "type": "boolean",
     "description": "exceto a própria carta"
    },
    "tipo": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "algum destes tipos (Creature, Land, Permanent, Card, Spell, Token…)"
    },
    "nao": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "nenhum destes tipos/subtipos/super (Land, Basic, Token…)"
    },
    "sub": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "algum destes subtipos; 'escolhido' = tipo escolhido ao entrar"
    },
    "super": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "ctrl": {
     "enum": [
      "voce",
      "oponente",
      "qualquer",
      "alvo",
      "cadaAtual",
      "doEvento"
     ]
    },
    "dono": {
     "enum": [
      "voce",
      "oponente",
      "qualquer",
      "alvo",
      "cadaAtual",
      "doEvento"
     ]
    },
    "cor": {
     "type": "string"
    },
    "zona": {
     "$ref": "#/$defs/zona"
    },
    "virada": {
     "type": "boolean"
    },
    "atacando": {
     "type": "boolean"
    },
    "equipada": {
     "type": "boolean",
     "description": "a criatura que este equipamento/aura está anexado"
    },
    "comandante": {
     "type": "boolean"
    },
    "ficha": {
     "type": "boolean"
    },
    "vm": {
     "$ref": "#/$defs/compara"
    },
    "poder": {
     "$ref": "#/$defs/compara"
    },
    "resist": {
     "$ref": "#/$defs/compara"
    },
    "anexadoA": {
     "enum": [
      "este"
     ],
     "description": "aura/equipamento anexado a esta carta"
    },
    "topo": {
     "type": "boolean",
     "description": "carta do topo do grimório"
    },
    "lembrada": {
     "type": "boolean",
     "description": "objeto lembrado pelo efeito"
    },
    "modificada": {
     "type": "boolean",
     "description": "equipada, encantada ou com marcador"
    },
    "conjurada": {
     "type": "boolean",
     "description": "foi conjurada (não só posta)"
    },
    "ouEste": {
     "type": "boolean",
     "description": "a própria carta também conta (\"este ou outro X\")"
    },
    "comMarcador": {
     "type": "string",
     "description": "tem ao menos 1 marcador deste tipo"
    },
    "kw": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "tem estas palavras-chave"
    }
   }
  },
  "compara": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "min": {
     "$ref": "#/$defs/qtd"
    },
    "max": {
     "$ref": "#/$defs/qtd"
    },
    "igual": {
     "$ref": "#/$defs/qtd"
    }
   }
  },
  "zona": {
   "enum": [
    "campo",
    "mao",
    "grimorio",
    "cemiterio",
    "exilio",
    "pilha",
    "comando",
    "qualquer"
   ]
  },
  "alvo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "f"
   ],
   "properties": {
    "f": {
     "oneOf": [
      {
       "$ref": "#/$defs/filtro"
      },
      {
       "enum": [
        "qualquerAlvo",
        "jogador",
        "oponente",
        "magica"
       ]
      }
     ]
    },
    "min": {
     "type": "integer"
    },
    "max": {
     "type": "integer"
    },
    "dividir": {
     "type": "boolean"
    },
    "jog": {
     "enum": [
      "jogador",
      "oponente"
     ],
     "description": "alvo pode ser também um jogador (f OU jog)"
    }
   }
  },
  "objeto": {
   "description": "sobre o que o efeito age: alvo escolhido (índice em 'alvos'), todos que batem no filtro, ou referência",
   "oneOf": [
    {
     "type": "object",
     "required": [
      "alvo"
     ],
     "additionalProperties": false,
     "properties": {
      "alvo": {
       "type": "integer"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "todos"
     ],
     "additionalProperties": false,
     "properties": {
      "todos": {
       "$ref": "#/$defs/filtro"
      }
     }
    },
    {
     "enum": [
      "este",
      "equipada",
      "doEvento",
      "criadas",
      "escolhida",
      "anterior",
      "cadaAtual"
     ]
    }
   ]
  },
  "custoAtv": {
   "type": "object",
   "additionalProperties": false,
   "description": "custo de habilidade ativada / custo adicional / 'a menos que pague'",
   "properties": {
    "mana": {
     "$ref": "#/$defs/mana"
    },
    "virar": {
     "type": "boolean"
    },
    "desvirar": {
     "type": "boolean"
    },
    "virarOutros": {
     "type": "object",
     "properties": {
      "f": {
       "$ref": "#/$defs/filtro"
      },
      "qtd": {
       "type": "integer"
      }
     }
    },
    "sacrificar": {
     "oneOf": [
      {
       "const": "este"
      },
      {
       "type": "object",
       "properties": {
        "f": {
         "$ref": "#/$defs/filtro"
        },
        "qtd": {
         "type": "integer"
        }
       }
      }
     ]
    },
    "descartar": {
     "type": "integer"
    },
    "revelar": {
     "type": "object",
     "properties": {
      "f": {
       "$ref": "#/$defs/filtro"
      },
      "qtd": {
       "type": "integer"
      }
     }
    },
    "exilarEste": {
     "type": "boolean"
    },
    "vida": {
     "oneOf": [
      {
       "type": "integer"
      },
      {
       "const": "X"
      }
     ]
    },
    "exilarDe": {
     "$ref": "#/$defs/zona"
    },
    "tirarMarcador": {
     "type": "object",
     "properties": {
      "tipo": {
       "type": "string"
      },
      "qtd": {
       "type": "integer"
      }
     }
    }
   }
  },
  "dura": {
   "enum": [
    "fimDoTurno",
    "proximoTurnoSeu",
    "enquantoAnexado",
    "enquantoNoCampo",
    "sempre"
   ]
  },
  "fxs": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/fx"
   }
  },
  "fx": {
   "type": "object",
   "required": [
    "op"
   ],
   "description": "um efeito. Campos comuns: talvez (o jogador pode escolher não fazer), quem (jogador que faz/recebe), em (objeto afetado), qtd, se (condição), aMenosQue (outro jogador paga para impedir)",
   "properties": {
    "op": {
     "enum": [
      "mana",
      "comprar",
      "descartar",
      "moer",
      "videncia",
      "cavar",
      "revelarTopo",
      "mover",
      "buscar",
      "embaralhar",
      "ficha",
      "copiarPermanente",
      "copiarMagica",
      "dano",
      "destruir",
      "sacrificar",
      "anular",
      "exilar",
      "ganharVida",
      "perderVida",
      "virar",
      "desvirar",
      "marcador",
      "proliferar",
      "modificar",
      "animar",
      "ganharControle",
      "anexar",
      "fasear",
      "transformar",
      "efeitoTemporario",
      "gatilhoAtrasado",
      "escolher",
      "modal",
      "repetirCada",
      "jogar",
      "faseExtra",
      "turnoExtra",
      "ganharJogo",
      "perderJogo",
      "regenerar",
      "virarMonarca",
      "descobrir",
      "vigiar",
      "lutar"
     ]
    },
    "talvez": {
     "type": "boolean"
    },
    "quem": {
     "$ref": "#/$defs/jogador"
    },
    "em": {
     "$ref": "#/$defs/objeto"
    },
    "qtd": {
     "$ref": "#/$defs/qtd"
    },
    "se": {
     "$ref": "#/$defs/cond"
    },
    "aMenosQue": {
     "type": "object",
     "required": [
      "quem",
      "custo"
     ],
     "properties": {
      "quem": {
       "$ref": "#/$defs/jogador"
      },
      "custo": {
       "$ref": "#/$defs/custoAtv"
      }
     }
    },
    "prod": {
     "description": "mana: cores produzidas; 'qualquer', 'comandante' (identidade), ou lista de opções",
     "oneOf": [
      {
       "enum": [
        "qualquer",
        "comandante",
        "refletida",
        "escolhida"
       ]
      },
      {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     ]
    },
    "de": {
     "$ref": "#/$defs/zona"
    },
    "para": {
     "$ref": "#/$defs/zona"
    },
    "f": {
     "$ref": "#/$defs/filtro",
     "description": "buscar/cavar/escolher: o que pode ser pego"
    },
    "virada": {
     "type": "boolean"
    },
    "atacando": {
     "type": "boolean"
    },
    "revelar": {
     "type": "boolean"
    },
    "sobControle": {
     "$ref": "#/$defs/jogador"
    },
    "fundo": {
     "type": "boolean",
     "description": "mover para o grimório: embaixo"
    },
    "olha": {
     "$ref": "#/$defs/qtd"
    },
    "pega": {
     "$ref": "#/$defs/qtd"
    },
    "resto": {
     "$ref": "#/$defs/zona"
    },
    "destinos": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "para": {
        "$ref": "#/$defs/zona"
       },
       "qtd": {
        "type": "integer"
       },
       "virada": {
        "type": "boolean"
       }
      }
     },
     "description": "buscar com divisão (Cultivate: 1 no campo virado, 1 na mão)"
    },
    "token": {
     "$ref": "#/$defs/token"
    },
    "tipoMarc": {
     "type": "string",
     "description": "marcador: +1/+1, -1/-1, loyalty, charge…"
    },
    "p": {
     "$ref": "#/$defs/qtd"
    },
    "r": {
     "$ref": "#/$defs/qtd"
    },
    "kw": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/kw"
     }
    },
    "dura": {
     "$ref": "#/$defs/dura"
    },
    "est": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/est"
     },
     "description": "efeitoTemporario: estáticas que valem pela duração"
    },
    "subst": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/subst"
     }
    },
    "quando": {
     "$ref": "#/$defs/gat",
     "description": "gatilhoAtrasado"
    },
    "o": {
     "enum": [
      "tipoCriatura",
      "cor",
      "jogador",
      "numero",
      "carta",
      "modo",
      "tipo"
     ],
     "description": "escolher: o quê"
    },
    "escolhe": {
     "type": "object",
     "properties": {
      "min": {
       "type": "integer"
      },
      "max": {
       "type": "integer"
      },
      "maxSe": {
       "type": "object",
       "properties": {
        "se": {
         "$ref": "#/$defs/cond"
        },
        "max": {
         "type": "integer"
        }
       }
      }
     }
    },
    "modos": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/fxs"
     }
    },
    "cada": {
     "oneOf": [
      {
       "$ref": "#/$defs/jogador"
      },
      {
       "$ref": "#/$defs/filtro"
      }
     ]
    },
    "fx": {
     "$ref": "#/$defs/fxs",
     "description": "repetirCada / sub-efeito"
    },
    "gratis": {
     "type": "boolean"
    },
    "semPilha": {
     "type": "boolean"
    },
    "pagando": {
     "$ref": "#/$defs/custoAtv",
     "description": "só faz se o controlador pagar este custo"
    },
    "a": {
     "$ref": "#/$defs/objeto",
     "description": "anexar: a quem"
    },
    "tipos": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "sub": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cores": {
     "type": "string"
    },
    "habil": {
     "type": "object",
     "properties": {
      "atv": {
       "type": "array"
      },
      "gat": {
       "type": "array"
      }
     }
    },
    "semHabil": {
     "type": "boolean"
    },
    "gat": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gat"
     },
     "description": "efeitoTemporario: gatilhos que valem pela duração"
    },
    "emblema": {
     "type": "boolean"
    },
    "novoAlvo": {
